{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VINE project v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "helperVersion": {
      "const": "1.0.0"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "node": {
          "const": "24.19.0"
        },
        "bun": {
          "const": "1.4.2"
        }
      },
      "required": [
        "node",
        "bun"
      ],
      "additionalProperties": false
    },
    "evidenceDir": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relevant": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sensitive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "include",
        "exclude",
        "extra",
        "relevant"
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "suites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selection": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "filterEnv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "adapter": {
                  "type": "string",
                  "enum": [
                    "workerd",
                    "playwright",
                    "vitest",
                    "json-status",
                    "built",
                    "removal"
                  ]
                }
              },
              "required": [
                "path",
                "adapter"
              ],
              "additionalProperties": false
            }
          },
          "artifact": {
            "type": "string",
            "enum": [
              "none",
              "application",
              "authority"
            ]
          },
          "expectedBoundaries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "category": {
            "type": "string",
            "enum": [
              "command",
              "behavioral"
            ]
          }
        },
        "required": [
          "script",
          "args",
          "selection",
          "filterEnv",
          "reports",
          "artifact",
          "category"
        ],
        "additionalProperties": false
      }
    },
    "scopes": {
      "type": "object",
      "properties": {
        "targeted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "documentation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "routine": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "full": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "targeted",
        "documentation",
        "routine",
        "full"
      ],
      "additionalProperties": false
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "mode": {
      "const": "advisory/manual-review"
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "patterns",
          "boundaries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "documentationPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "helperVersion",
    "runtime",
    "evidenceDir",
    "inputs",
    "authority",
    "suites",
    "scopes",
    "boundaries",
    "protected",
    "mode",
    "routing"
  ],
  "additionalProperties": false
}
